      {
        "id": "text_subtitles",
        "type": "text",
        "name": "Hindi Subtitles",
        "clips": [
          { "id": "sub_1", "type": "text", "name": "Scene 1 Narration", "startTime": 0, "duration": 10, "color": "#f59e0b", "metadata": { "text": "एक छोटे से भारतीय गाँव में 26 साल का अमन अपने पुराने पुश्तैनी घर में अकेला रहता था।" } },
          { "id": "sub_2", "type": "text", "name": "Scene 2 Narration", "startTime": 10, "duration": 12, "color": "#f59e0b", "metadata": { "text": "एक रात करीब 12 बजे अमन को उस बंद कमरे से किसी के रोने की आवाज सुनाई दी।" } },
          { "id": "sub_3", "type": "text", "name": "Voice: Aman...", "startTime": 18, "duration": 4, "color": "#ff4444", "metadata": { "text": "\"अमन... दरवाजा खोलो।\"" } },
          { "id": "sub_4", "type": "text", "name": "Scene 3 Narration", "startTime": 22, "duration": 10, "color": "#f59e0b", "metadata": { "text": "अगली सुबह उसने पड़ोस में रहने वाले बुजुर्ग शंकर काका से इस बारे में पूछा।" } },
          { "id": "sub_5", "type": "text", "name": "Shankar Kaka", "startTime": 28, "duration": 4, "color": "#ff4444", "metadata": { "text": "\"बेटा, उस कमरे को कभी मत खोलना।\"" } },
          { "id": "sub_6", "type": "text", "name": "Scene 4 Narration", "startTime": 32, "duration": 14, "color": "#f59e0b", "metadata": { "text": "उसी रात उसने मोबाइल का कैमरा चालू किया और कमरे के दरवाजे के सामने रख दिया।" } },
          { "id": "sub_7", "type": "text", "name": "Knocks", "startTime": 32.5, "duration": 3, "color": "#ffaa00", "metadata": { "text": "*तीन बार दस्तक*" } },
          { "id": "sub_8", "type": "text", "name": "Scene 5 Narration", "startTime": 46, "duration": 12, "color": "#f59e0b", "metadata": { "text": "अमन ने तस्वीर उठाई। उसमें उसके पिता खड़े थे और उनके बगल में बिल्कुल अमन जैसा दिखने वाला एक दूसरा युवक था।" } },
          { "id": "sub_9", "type": "text", "name": "Scene 6 Narration", "startTime": 58, "duration": 14, "color": "#f59e0b", "metadata": { "text": "अमन घबराकर शंकर काका के घर पहुँचा। बहुत पूछने पर उन्होंने सच बताया।" } },
          { "id": "sub_10", "type": "text", "name": "Shankar Kaka Truth", "startTime": 64, "duration": 8, "color": "#ff4444", "metadata": { "text": "\"तुम्हारे जन्म के दिन दो जुड़वाँ बच्चे हुए थे। दूसरा बच्चा गायब हो गया था।\"" } },
          { "id": "sub_11", "type": "text", "name": "Scene 7 Narration", "startTime": 72, "duration": 15, "color": "#f59e0b", "metadata": { "text": "अमन तुरंत घर लौटा। बंद कमरे के अंदर से अब किसी के रोने की आवाज नहीं आ रही थी।" } },
          { "id": "sub_12", "type": "text", "name": "Wardrobe Knocks", "startTime": 84, "duration": 3, "color": "#ffaa00", "metadata": { "text": "*अलमारी से तीन बार दस्तक*" } },
          { "id": "sub_13", "type": "text", "name": "Scene 8 Narration", "startTime": 87, "duration": 15, "color": "#f59e0b", "metadata": { "text": "अलमारी का दरवाजा अपने आप खुला। दीवार पर एक नया फोटो था जिसमें अमन और वो दूसरा युवक था।" } },
          { "id": "sub_14", "type": "text", "name": "Final SMS", "startTime": 101, "duration": 4, "color": "#00ffff", "metadata": { "text": "\"अब तुम्हें पता चल गया कि तुम इस घर में अकेले नहीं हो।\"" } }
        ]
